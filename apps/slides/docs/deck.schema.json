                      "default": null,
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^#[0-9A-Fa-f]{6}$"
                            },
                            {
                              "type": "string",
                              "enum": [
                                "background",
                                "text",
                                "heading",
                                "accent1",
                                "accent2",
                                "accent3",
                                "accent4",
                                "accent5",
                                "accent6"
                              ]
                            }
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "A hex color like \"#1F7A8C\", a theme slot like \"accent1\", or null for none"
