  "required": [
    "format",
    "formatVersion",
    "theme",
    "slides"
  ],
  "additionalProperties": {},
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "doc",
            "paragraph",
            "text",
            "hardBreak",
            "bulletList",
            "orderedList",
            "listItem"
          ]
        },
        "text": {
          "type": "string"
        },
        "attrs": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "bold",
                  "italic",
                  "underline",
                  "strike",
                  "textStyle",
                  "highlight",
                  "link"
                ]
              },
              "attrs": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": {}
          }
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": {}
    }
