                  "required": [
                    "id",
                    "type",
                    "x",
                    "y",
                    "w",
                    "h",
                    "columnWidths",
                    "rows"
                  ],
                  "additionalProperties": {}
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "chart"
                    },
                    "x": {
                      "type": "number",
                      "description": "Slide units (the slide is size.width by size.height)"
                    },
                    "y": {
                      "type": "number",
                      "description": "Slide units (the slide is size.width by size.height)"
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Slide units (the slide is size.width by size.height)"
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Slide units (the slide is size.width by size.height)"
                    },
