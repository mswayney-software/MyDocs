{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "myslides-deck-v1",
  "title": "MySlides deck.json",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "myslides"
    },
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "app": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": {}
    },
    "meta": {
      "default": {
        "title": ""
      },
      "type": "object",
      "properties": {
        "title": {
          "default": "",
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "modified": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "size": {
      "default": {
        "width": 1280,
        "height": 720
