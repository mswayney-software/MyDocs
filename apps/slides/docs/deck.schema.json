                                "number",
                                "null"
                              ]
                            }
                          }
                        },
                        "required": [
                          "name",
                          "values"
                        ],
                        "additionalProperties": {}
                      }
                    },
                    "options": {
                      "default": {
                        "legend": true,
                        "xTitle": "",
                        "yTitle": ""
                      },
                      "type": "object",
                      "properties": {
                        "legend": {
                          "default": true,
                          "type": "boolean"
                        },
                        "xTitle": {
                          "default": "",
                          "type": "string"
                        },
                        "yTitle": {
                          "default": "",
                          "type": "string"
                        }
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "x",
                    "y",
                    "w",
                    "h",
                    "chartType",
                    "categories",
                    "series"
                  ],
                  "additionalProperties": {}
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "elements"
        ],
        "additionalProperties": {}
      }
