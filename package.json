{
  "name": "mysuite",
  "private": true,
  "type": "module",
  "description": "MyDocs and MySlides: free offline school apps. No account, no tracking; your files stay on your device.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mswayney-software/MyDocs.git"
  },
  "homepage": "https://github.com/mswayney-software/MyDocs#readme",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:docs": "npm run dev -w mydocs",
    "dev:slides": "npm run dev -w myslides",
    "build": "npm run build -w mydocs -w myslides",
    "lint": "oxlint",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "pdfjs-dist": "^4.10.38",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1"
  }
}
